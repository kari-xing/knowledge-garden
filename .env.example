# ===================== 后端 =====================
# PostgreSQL（本机 Docker 或本地安装）
DATABASE_URL=postgresql+asyncpg://garden:garden@localhost:5432/knowledge_garden
# Redis（队列 / 缓存，未启动时 USE_ARQ=false 自动降级）
REDIS_URL=redis://localhost:6379/0

# JWT 密钥（生产环境务必替换）
SECRET_KEY=change-me-in-production

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8001

# LLM Provider：deepseek（默认，云端）/ ollama（本地可选）/ openai_compatible
LLM_PROVIDER=deepseek
# DeepSeek（默认 LLM，OpenAI 兼容协议）
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_MODEL=deepseek-v4-flash
# Ollama 本地推理（可选；切换时 LLM_PROVIDER=ollama，嵌入模型仍用 bge-m3）
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_EMBEDDING_MODEL=bge-m3

# 备选：任意 OpenAI 兼容 API
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_API_KEY=sk-xxx
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# AI 流水线参数
SIMILARITY_THRESHOLD=0.7
TOP_K=5
# 任务队列：true 走 ARQ(Redis)；false 降级为 FastAPI BackgroundTasks
USE_ARQ=false

# 是否开启调试 SQL 日志
DEBUG=false

# ===================== 前端 =====================
VITE_API_BASE=/api/v1
